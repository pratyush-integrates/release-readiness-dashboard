# Your Atlassian Cloud site, e.g. https://your-team.atlassian.net
ATLASSIAN_SITE=
ATLASSIAN_EMAIL=
# Create at https://id.atlassian.com/manage-profile/security/api-tokens
ATLASSIAN_API_TOKEN=
CONFLUENCE_SPACE_KEY=REL
FLASK_SECRET_KEY=change-me
# Leave the credentials empty (or set MOCK_MODE=1) to use the built-in mock Jira/Confluence.
MOCK_MODE=
MOCK_URL=http://127.0.0.1:5001
CACHE_SECONDS=60
